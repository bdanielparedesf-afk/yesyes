# Keys y secretos (en cualquier directorio)
.env
.env.*
*.env
# Solo estas plantillas pueden versionarse; deben contener valores vacíos.
!/.env.example
!/backend/.env.example
!/frontend/.env.example

# Dependencias
node_modules/
dist/

# Sistema
.DS_Store

# Logs
*.log
logs/

.vercel

# QA / harness: artefactos generados en tiempo de ejecución.
# Los scripts del harness (qa/*.mjs) SÍ se versionan; los resultados no.

# Perfil de Chrome usado por los runners de QA (muy pesado, ~2 GB)
.qa-chrome-profile/
qa/.qa-chrome-profile/
**/.qa-chrome-profile/
logs/cert-chrome/

# Certificacion E2E autonoma (Fases B-X).
# qa/cert-negocio.json guarda la SESION REAL de una cuenta creada por la UI
# (token JWT en claro). NUNCA debe versionarse.
qa/cert-negocio.json
qa/cert-captures/

# Capturas de pantalla y artefactos temporales de certificación
qa/final-responsive/
qa/qa/
*.tmp

# Reportes generados por el harness
qa/*-report.json
qa/*.exit
qa/*-exit
qa/git-diff-check-*.log

# Scripts de depuración temporales
qa/_orphan-sweep.mjs

# Binarios generados para la certificacion (PNG/WebM) y capturas antiguas.
# Se regeneran con `node qa/cert/make-images.mjs` / `make-video.mjs`.
qa/cert-media/
qa/business-captures/
qa/f4-variants/
qa/final-responsive/

# Reportes por fase: contienen identificadores de la sesion real.
qa/cert-phase-*.json

# Artefactos de compilacion de TypeScript.
*.tsbuildinfo
frontend/dist/
qa/*.log
qa/*.exit
qa/run-backend-tests.cmd
qa/commit-msg.txt
