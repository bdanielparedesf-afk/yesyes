# Plantilla sin credenciales. Completar solo en el entorno privado del servidor.
# No copiar secretos al frontend ni versionar archivos .env privados.
DATABASE_URL=
DIRECT_URL=
PORT=
NODE_ENV=
CORS_ORIGIN=
FRONTEND_URL=
BACKEND_URL=
AUTH_URL=
NEXTAUTH_URL=
AUTH_SECRET=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CJ_API_KEY=
CJ_EMAIL=
# Mercado Pago OAuth por Business (Fase 3+)
# Client ID y Secret de la APP de Mercado Pago de YesYes (NO de cada Business)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Redirect URI registrada en la app Mercado Pago (backend route, HTTPS en prod)
# Prod: https://yesyes.cl/api/mercadopago/oauth/callback
# Local: http://localhost:5173/api/mercadopago/oauth/callback
MERCADOPAGO_OAUTH_REDIRECT_URI=

# Clave de cifrado para tokens de Mercado Pago por Business (32 bytes = 64 hex chars)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=
CRON_SECRET=
LOG_LEVEL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ALIEXPRESS_API_KEY=
ALIEXPRESS_API_SECRET=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Exact callback registered in AliExpress Open Platform (backend route, same origin as panel).
# Production: https://yesyes.cl/api/admin/aliexpress/oauth/callback
# Local only if registered: http://localhost:5173/api/admin/aliexpress/oauth/callback
ALIEXPRESS_OAUTH_REDIRECT_URI=
ALIEXPRESS_GATEWAY=https://api-sg.aliexpress.com/sync
# Read-only probe: direct private access token OR encrypted token selected by account.
ALIEXPRESS_PROBE_ACCOUNT=
ALIEXPRESS_PROBE_KEYWORD=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REFRESH_TOKEN=
ALIEXPRESS_SELLER_ID=
# Backend-only encryption key: 32 random bytes represented as 64 hex characters.
ALIEXPRESS_TOKEN_ENCRYPTION_KEY=
# Order execution kill-switch. NEVER set to true locally or in Preview.
# Only set ALIEXPRESS_ORDER_EXECUTION=true in the Production environment.
ALIEXPRESS_ORDER_EXECUTION=
# FX_SOURCE: mindicador (default) or manual. Manual rate requires ISO timestamp.
FX_SOURCE=
FX_USD_CLP_RATE=
FX_OBSERVED_AT=
# Supabase Storage para uploads de Business (logo, portada, galeria, servicios,
# propiedades, catalogo). La SERVICE ROLE key es obligatoria (uso server-side);
# SUPABASE_URL es opcional si DATABASE_URL ya apunta a Supabase (se deriva).
# El bucket (default "business-images") se crea automaticamente como publico.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=


