generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  PAUSED
  OUT_OF_STOCK
  NOT_PROFITABLE
  ARCHIVED
}

enum ProductSupplier {
  ALIEXPRESS
  TEMU
  AMAZON
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SUPPLIER_ORDERED
  SUPPLIER_PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUND_PROCESSING
  REFUNDED
  DISPUTED
  PENDING
  FULFILLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentProvider {
  DROPSHIP_DEFAULT
  DSERS
  ALIEXPRESS_DIRECT
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum AppealStatus {
  OPEN
  REVIEWING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  name          String
  lastName      String
  phone         String?
  emailVerified Boolean   @default(false)
  googleId      String?   @unique
  avatar        String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  cart          Cart?
  auditLogs     AuditLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@map("categories")
}

model Supplier {
  id         String            @id @default(cuid())
  name       String
  provider   FulfillmentProvider @default(DSERS)
  apiKey     String?
  isActive   Boolean           @default(true)
  products   Product[]         @relation("ProductSupplier")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model PriceRule {
  id            String    @id @default(cuid())
  name          String
  defaultMargin Int       @default(60)
  shippingCost  Decimal   @default(0)
  commission    Decimal   @default(0)
  currency      String    @default("CLP")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AutomationLog {
  id        String   @id @default(cuid())
  type      String
  entityId  String?
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Product {
  id                String          @id @default(uuid())
  name              String
  slug              String          @unique
  description       String          @db.Text
  images            Json
  video             String?
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  tags              Json
  sku               String?
  supplier          ProductSupplier @default(ALIEXPRESS)
  supplierProductId String?
  supplierUrl       String?
  variants          Json
  stock             Int             @default(0)
  productCost       Float
  shippingCost      Float           @default(0)
  totalCost         Float
  salePrice         Float
  margin            Float
  weight            Float?
  dimensions        Json?
  status            ProductStatus   @default(DRAFT)
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  supplierId        String?
  supplierRelation  Supplier?       @relation("ProductSupplier", fields: [supplierId], references: [id])
  aliexpressId      String?
  aliexpressUrl     String?
  supplierPrice     Float?
  shippingCostExtra Float?          @default(0)
  profitMargin      Int             @default(60)
  importSource      String          @default("DSERS")
  dserStatus        String          @default("draft")
  isFeatured        Boolean         @default(false)
  isOffer           Boolean         @default(false)

  orderItems        OrderItem[] @relation("ProductOrderItems")
  cartItems         CartItem[]
  productVariants   ProductVariant[] @relation("ProductVariants")
  productImages     ProductImage[] @relation("ProductImages")
  productReviews    ProductReview[] @relation("ProductReviews")
  productInventory  Inventory[] @relation("ProductInventory")

  @@map("products")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  subtotal  Float      @default(0)
  shipping  Float      @default(0)
  discount  Float      @default(0)
  total     Float      @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variant   Json?
  quantity  Int
  unitPrice Float
  totalPrice Float
  createdAt DateTime @default(now())

  @@map("cart_items")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING_PAYMENT)
  items           Json
  subtotal        Float
  shipping        Float
  discount        Float
  total           Float
  couponId        String?
  paymentId       String?
  paymentStatus   PaymentStatus @default(PENDING)
  shippingAddress Json
  tracking        Json?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  orderItems      OrderItem[] @relation("OrderItems")
  payments        Payment[]
  history         OrderStatusHistory[]
  fulfillments    Fulfillment[]
  returnRequests  ReturnRequest[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation("OrderItems", fields: [orderId], references: [id])
  productId   String
  product     Product @relation("ProductOrderItems", fields: [productId], references: [id])
  productName String
  productImage String
  variant     Json?
  variantId   String?
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  price       Float?
  createdAt   DateTime @default(now())

  @@map("order_items")
}

model Coupon {
  id          String        @id @default(uuid())
  code        String        @unique
  discountType DiscountType
  value       Decimal
  maxUses     Int           @default(100)
  usedCount   Int           @default(0)
  minAmount   Decimal?
  validUntil  DateTime?
  isActive    Boolean       @default(true)
  usages      CouponUsage[]
  createdAt   DateTime      @default(now())
}

model CouponUsage {
  id        String    @id @default(uuid())
  couponId  String
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  orderId   String?
  usedAt    DateTime  @default(now())
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation("ProductVariants", fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  size      String?
  color     String?
  price     Decimal
  stock     Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
}

model Inventory {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation("ProductInventory", fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  quantity    Int
  warehouseId String? @default("main")
  updatedAt   DateTime @updatedAt
}

model ProductReview {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation("ProductReviews", fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  rating          Int
  comment         String?
  images          String[]
  isVerified      Boolean  @default(false)
  isModerated     Boolean  @default(false)
  verifiedPurchase Boolean @default(false)
  createdAt       DateTime @default(now())
}

model Wishlist {
  id        String        @id @default(uuid())
  userId    String        @unique
  items     WishlistItem[]
  createdAt DateTime      @default(now())
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

model Account {
  id               String @id @default(uuid())
  userId           String
  provider         String
  providerAccountId String
  createdAt        DateTime @default(now())

  @@unique([userId, provider, providerAccountId])
}

model PaymentProvider {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  credentials Json?
  createdAt DateTime @default(now())
  payments  Payment[]
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  providerId  String
  provider    PaymentProvider @relation(fields: [providerId], references: [id])
  amount      Decimal
  currency    String   @default("CLP")
  status      PaymentStatus @default(PENDING)
  externalId  String?
  preferenceId String?
  webhookData Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      PaymentEvent[]
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now())
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  changedById String?
  note       String?
  createdAt  DateTime @default(now())
}

model Fulfillment {
  id            String           @id @default(cuid())
  orderId       String
  order         Order            @relation(fields: [orderId], references: [id])
  provider      FulfillmentProvider @default(DROPSHIP_DEFAULT)
  trackingCode  String?
  status        String           @default("pending")
  trackingEvents TrackingEvent[]
  createdAt     DateTime         @default(now())
}

model TrackingEvent {
  id           String    @id @default(cuid())
  fulfillmentId String?
  fulfillment  Fulfillment? @relation(fields: [fulfillmentId], references: [id])
  orderId      String
  status       String
  location     String?
  description  String?
  occurredAt   DateTime  @default(now())
}

model ReturnRequest {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id])
  reason     String
  status     ReturnStatus  @default(REQUESTED)
  description String?
  items      ReturnItem[]
  appeals    Appeal[]
  createdAt  DateTime      @default(now())
}

model ReturnItem {
  id            String       @id @default(cuid())
  returnRequestId String
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId   String
  quantity      Int
}

model Appeal {
  id            String      @id @default(cuid())
  returnRequestId String
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  reason        String
  evidenceUrls  String[]
  status        AppealStatus @default(OPEN)
  createdAt     DateTime    @default(now())
}

model SupportTicket {
  id        String      @id @default(cuid())
  userId    String
  subject   String
  status    TicketStatus @default(OPEN)
  messages  TicketMessage[]
  createdAt DateTime   @default(now())
}

model TicketMessage {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  message   String
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model SeoMeta {
  id         String   @id @default(cuid())
  entityType String
  entityId   String?
  slug       String   @unique
  title      String?
  description String?
  ogImage    String?
  createdAt  DateTime @default(now())
}

model BackupLog {
  id        String   @id @default(cuid())
  status    String
  fileUrl   String?
  size      Int?
  metadata  Json?
  createdAt DateTime @default(now())
}
