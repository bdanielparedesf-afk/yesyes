generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  password                String?
  name                    String
  lastName                String
  phone                   String?
  emailVerified           Boolean                   @default(false)
  googleId                String?                   @unique
  avatar                  String?
  role                    UserRole                  @default(CUSTOMER)
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  auditLogs               AuditLog[]
  cart                    Cart?
  orders                  Order[]
  verificationTokens      VerificationToken[]
  businesses              Business[]
  MercadoPagoOAuthAttempt MercadoPagoOAuthAttempt[]

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?
  order       Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Supplier {
  id        String              @id @default(cuid())
  name      String
  provider  FulfillmentProvider @default(DSERS)
  apiKey    String?
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  Product[]           @relation("ProductSupplier")
}

model PriceRule {
  id            String   @id @default(cuid())
  name          String
  defaultMargin Int      @default(60)
  shippingCost  Decimal  @default(0)
  commission    Decimal  @default(0)
  currency      String   @default("CLP")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AutomationLog {
  id        String   @id @default(cuid())
  type      String
  entityId  String?
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Collection {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  image     String?
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("collections")
}

model Product {
  id                         String           @id @default(uuid())
  name                       String
  slug                       String           @unique
  description                String
  images                     Json
  video                      String?
  categoryId                 String
  tags                       String[]
  sku                        String?
  supplier                   ProductSupplier  @default(ALIEXPRESS)
  supplierProductId          String?
  supplierUrl                String?
  variants                   Json
  stock                      Int              @default(0)
  productCost                Float
  shippingCost               Float            @default(0)
  totalCost                  Float
  salePrice                  Float
  margin                     Float
  weight                     Float?
  dimensions                 Json?
  status                     ProductStatus    @default(DRAFT)
  seoTitle                   String?
  seoDescription             String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  aliexpressId               String?
  aliexpressUrl              String?
  dserStatus                 String           @default("draft")
  importSource               String           @default("DSERS")
  isFeatured                 Boolean          @default(false)
  isOffer                    Boolean          @default(false)
  profitMargin               Int              @default(60)
  shippingCostExtra          Float?           @default(0)
  supplierId                 String?
  supplierPrice              Float?
  cjProductId                String?
  cjVariants                 Json?
  sourceUrl                  String?
  sourcePlatform             String?
  sourceId                   String?
  costUsd                    Float?
  lastCheckedAt              DateTime?
  hasAlert                   Boolean          @default(false)
  alert                      String?
  alertLevel                 String           @default("info")
  hidden                     Boolean          @default(false)
  collectionId               String?
  collection                 Collection?      @relation(fields: [collectionId], references: [id])
  aliexpressMarginPercent    Int?
  aliexpressShippingUsdCents Int?
  aliexpressShippingUnknown  Boolean          @default(false)
  aliexpressSyncedAt         DateTime?
  aliexpressSnapshot         Json?
  productInventory           Inventory[]      @relation("ProductInventory")
  productImages              ProductImage[]   @relation("ProductImages")
  productReviews             ProductReview[]  @relation("ProductReviews")
  productVariants            ProductVariant[] @relation("ProductVariants")
  cartItems                  CartItem[]
  orderItems                 OrderItem[]      @relation("ProductOrderItems")
  category                   Category         @relation(fields: [categoryId], references: [id])
  supplierRelation           Supplier?        @relation("ProductSupplier", fields: [supplierId], references: [id])
  businessId                 String?

  @@index([businessId])
  @@map("products")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  subtotal  Float      @default(0)
  shipping  Float      @default(0)
  discount  Float      @default(0)
  total     Float      @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id])

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  productId  String
  variant    Json?
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())
  cart       Cart     @relation(fields: [cartId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

model Order {
  id              String               @id @default(uuid())
  orderNumber     String               @unique
  userId          String?
  businessId      String?
  business        Business?            @relation(fields: [businessId], references: [id])
  status          OrderStatus          @default(PENDING_PAYMENT)
  items           Json
  subtotal        Float
  shipping        Float
  discount        Float
  total           Float
  couponId        String?
  paymentId       String?
  paymentStatus   PaymentStatus        @default(PENDING)
  shippingAddress Json
  tracking        Json?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  fulfillments    Fulfillment[]
  history         OrderStatusHistory[]
  payments        Payment[]
  returnRequests  ReturnRequest[]
  orderItems      OrderItem[]          @relation("OrderItems")
  user            User?                @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  productImage String
  variant      Json?
  variantId    String?
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  price        Float?
  createdAt    DateTime @default(now())
  order        Order    @relation("OrderItems", fields: [orderId], references: [id])
  product      Product  @relation("ProductOrderItems", fields: [productId], references: [id])

  @@map("order_items")
}

model Coupon {
  id           String        @id @default(uuid())
  code         String        @unique
  discountType DiscountType
  value        Decimal
  maxUses      Int           @default(100)
  usedCount    Int           @default(0)
  minAmount    Decimal?
  validUntil   DateTime?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  usages       CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id                  String   @id @default(uuid())
  productId           String
  sku                 String   @unique
  size                String?
  color               String?
  price               Decimal
  stock               Int      @default(0)
  supplierVariantId   String?
  supplierAttributes  Json?
  supplierImage       String?
  supplierCostUsd     Float?
  supplierShippingUsd Float?
  /// null means the provider did not report stock; never coerced to 0.
  supplierStock       Int?
  supplierStockKnown  Boolean  @default(false)
  createdAt           DateTime @default(now())
  product             Product  @relation("ProductVariants", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, supplierVariantId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  product   Product @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)
}

model Inventory {
  id          String   @id @default(uuid())
  productId   String
  variantId   String?
  quantity    Int
  warehouseId String?  @default("main")
  updatedAt   DateTime @updatedAt
  product     Product  @relation("ProductInventory", fields: [productId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id               String   @id @default(uuid())
  productId        String
  userId           String
  rating           Int
  comment          String?
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  images           String[]
  isModerated      Boolean  @default(false)
  isVerified       Boolean  @default(false)
  product          Product  @relation("ProductReviews", fields: [productId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([userId, provider, providerAccountId])
}

model PaymentProvider {
  id          String    @id @default(cuid())
  name        String
  isActive    Boolean   @default(true)
  credentials Json?
  createdAt   DateTime  @default(now())
  payments    Payment[]
}

model Payment {
  id           String          @id @default(cuid())
  orderId      String
  businessId   String?
  business     Business?       @relation(fields: [businessId], references: [id])
  providerId   String
  amount       Decimal
  currency     String          @default("CLP")
  status       PaymentStatus   @default(PENDING)
  externalId   String?
  preferenceId String?
  webhookData  Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  order        Order           @relation(fields: [orderId], references: [id])
  provider     PaymentProvider @relation(fields: [providerId], references: [id])
  events       PaymentEvent[]

  @@index([businessId])
  @@map("payments")
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  type      String
  payload   Json?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  fromStatus  String?
  toStatus    String
  changedById String?
  note        String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Fulfillment {
  id             String              @id @default(cuid())
  orderId        String
  provider       FulfillmentProvider @default(DROPSHIP_DEFAULT)
  trackingCode   String?
  status         String              @default("pending")
  createdAt      DateTime            @default(now())
  order          Order               @relation(fields: [orderId], references: [id])
  trackingEvents TrackingEvent[]
}

model TrackingEvent {
  id            String       @id @default(cuid())
  fulfillmentId String?
  orderId       String
  status        String
  location      String?
  description   String?
  occurredAt    DateTime     @default(now())
  fulfillment   Fulfillment? @relation(fields: [fulfillmentId], references: [id])
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  reason      String
  status      ReturnStatus @default(REQUESTED)
  description String?
  createdAt   DateTime     @default(now())
  appeals     Appeal[]
  items       ReturnItem[]
  order       Order        @relation(fields: [orderId], references: [id])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
}

model Appeal {
  id              String        @id @default(cuid())
  returnRequestId String
  reason          String
  evidenceUrls    String[]
  status          AppealStatus  @default(OPEN)
  createdAt       DateTime      @default(now())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String          @id @default(cuid())
  userId    String
  subject   String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  messages  TicketMessage[]
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  createdAt DateTime @default(now())
  entity    String
  entityId  String?
  ip        String?
  metadata  Json?
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model SeoMeta {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String?
  slug        String   @unique
  title       String?
  description String?
  ogImage     String?
  createdAt   DateTime
}

/// Short-lived, single-use server-side AliExpress OAuth attempt. No credentials.
model AliExpressOAuthAttempt {
  stateHash   String   @id @map("state_hash")
  browserHash String   @map("browser_hash")
  userId      String   @map("user_id")
  account     String?
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("aliexpress_oauth_attempts")
}

model AliexpressToken {
  id               String   @id @default(uuid())
  account          String   @unique
  sellerId         String?  @map("seller_id")
  accessToken      String   @map("access_token")
  refreshToken     String   @map("refresh_token")
  expiresAt        DateTime @map("expires_at")
  refreshExpiresAt DateTime @map("refresh_expires_at")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("aliexpress_tokens")
}

/// Bulk import queue. One row per requested AliExpress URL; items are processed
/// sequentially so a single failure never blocks the rest of the queue.
model AliExpressImportJob {
  id            String                    @id @default(uuid())
  status        String                    @default("PENDING")
  total         Int                       @default(0)
  processed     Int                       @default(0)
  succeeded     Int                       @default(0)
  failed        Int                       @default(0)
  marginPercent Int                       @default(100)
  shippingMode  String                    @default("PROVIDER")
  categoryId    String?
  createdBy     String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  items         AliExpressImportJobItem[]

  @@map("aliexpress_import_jobs")
}

model AliExpressImportJobItem {
  id               String              @id @default(uuid())
  jobId            String
  sourceUrl        String
  aliexpressId     String?
  status           String              @default("PENDING")
  attempts         Int                 @default(0)
  error            String?
  createdProductId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  job              AliExpressImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@map("aliexpress_import_job_items")
}

/// Price/stock synchronisation history. `changes` keeps the previous and current
/// supplier values; the sale price is only rewritten when explicitly enabled.
model AliExpressSyncLog {
  id                     String   @id @default(uuid())
  productId              String?
  aliexpressId           String
  status                 String
  costBeforeUsd          Float?
  costAfterUsd           Float?
  stockBefore            Int?
  stockAfter             Int?
  skuId                  String?
  shippingBeforeUsdCents Int?
  shippingAfterUsdCents  Int?
  shippingStatus         String?
  changes                Json?
  error                  String?
  createdAt              DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("aliexpress_sync_logs")
}

/// Singleton configuration of the AliExpress Sync Engine. Additive-only; a
/// missing row means defaults (enabled, hourly, AUTO_UPDATE, block on unknown cost).
model AliExpressSyncSettings {
  id               String    @id @default("singleton")
  enabled          Boolean   @default(true)
  /// Minutes between automatic runs. Allowed: 30, 60, 360, 720, 1440.
  intervalMinutes  Int       @default(60) @map("interval_minutes")
  /// What to do when the provider price changed since the last sync at order time.
  stalePricePolicy String    @default("AUTO_UPDATE")
  /// What to do when the total cost cannot be calculated with certainty.
  noQuotePolicy    String    @default("BLOCK")
  /// Products processed per batch; batches run sequentially (rate-limit friendly).
  batchSize        Int       @default(10)
  lastRunAt        DateTime? @map("last_run_at")
  lastCursor       String?   @map("last_cursor")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("aliexpress_sync_settings")
}

/// Immutable snapshot of the supplier order data needed to preserve the original
/// purchase information (provider request, response and tracking).
model AliExpressOrderSnapshot {
  id                String   @id @default(uuid())
  orderId           String   @unique
  aliexpressOrderId String?
  status            String   @default("PREPARED")
  request           Json
  response          Json?
  tracking          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("aliexpress_order_snapshots")
}

model BackupLog {
  id        String   @id @default(cuid())
  status    String
  fileUrl   String?
  size      Int?
  metadata  Json?
  createdAt DateTime @default(now())
}

enum UserRole {
  CUSTOMER
  ADMIN
  BUSINESS
}

enum BusinessStatus {
  DRAFT
  PREVIEW
  PAYMENT_PENDING
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum ConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum BusinessCategoryCode {
  HAIR
  BARBER
  BAKERY
  FLOWERS
  FOOD
  BOUTIQUE
  FURNITURE
  REAL_ESTATE
  MECHANIC
  PHONE
  CLEANING
  PHOTO
  TUTORING
  CONSTRUCTION
  BEAUTY
  PET
  DETAILING
  CAFE
  NAILS
  FITNESS
  AUTO
  PRO
}

enum PropertyOperation {
  VENTA
  ARRIENDO
}

enum PropertyType {
  CASA
  DEPARTAMENTO
  TERRENO
  OFICINA
  LOCAL
  PARCELA
  BODEGA
}

enum LeadType {
  RESERVA
  COTIZACION
  CONSULTA
  PEDIDO
  PROPERTY_INQUIRY
}

/// Ciclo de vida administrativo de un lead del negocio.
enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
  SPAM
}

/// Estado de la suscripcion que paga el negocio a YesYes. Es INDEPENDIENTE
/// de Business.status: una pagina puede estar PAUSED con suscripcion ACTIVE
/// o PUBLISHED con suscripcion en GRACE_PERIOD (periodo de gracia).
enum SubscriptionStatus {
  NONE
  PENDING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  PAUSED
  CANCELLED
  EXPIRED
}

enum SubscriptionFrequency {
  MONTH
  YEAR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED
  TEXT_ONLY
}

enum BusinessReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BusinessCategory {
  id          String               @id @default(uuid())
  code        BusinessCategoryCode @unique
  name        String
  description String?
  icon        String?
  active      Boolean              @default(true)
  order       Int                  @default(0)
  /// Matriz de capacidades por rubro (seed). ADMIN puede modificarla:
  /// es el default de referencia, nunca un limite duro.
  defaultCapabilities String[]     @default([])

  @@index([active])
  @@index([order])
  @@map("business_categories")
}

model BusinessTemplate {
  id           String               @id @default(uuid())
  category     BusinessCategoryCode
  code         String               @unique
  name         String
  description  String?
  version      Int                  @default(1)
  active       Boolean              @default(true)
  previewUrl   String?
  previewImage String?
  sortOrder    Int                  @default(0)
  capabilities String[]
  config       Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  businesses   Business[]

  @@index([category])
  @@index([active])
  @@map("business_templates")
}

model Business {
  id                      String                    @id @default(uuid())
  ownerId                 String
  owner                   User                      @relation(fields: [ownerId], references: [id])
  name                    String
  slug                    String                    @unique
  category                BusinessCategoryCode
  templateId              String?
  template                BusinessTemplate?         @relation(fields: [templateId], references: [id])
  status                  BusinessStatus            @default(DRAFT)
  logo                    String?
  cover                   String?
  description             String?                   @db.Text
  phone                   String?
  whatsapp                String?
  email                   String?
  address                 String?
  city                    String?
  region                  String?
  mapsUrl                 String?
  lat                     Float?
  lng                     Float?
  hours                   Json?
  socials                 Json?
  cta                     Json?
  settings                Json?
  /// Configuracion visual tipada y saneada (colores, tipografias, radios,
  /// tema, orden de secciones). Nunca se aplica sin pasar por el sanitizador.
  visual                  Json?
  seoTitle                String?
  seoDescription          String?
  ogImage                 String?
  canonical               String?
  publishedAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  services                BusinessService[]
  catalogItems            BusinessCatalogItem[]
  properties              Property[]
  gallery                 BusinessGalleryImage[]
  leads                   BusinessLead[]
  orders                  Order[]
  payments                Payment[]
  mercadoPago             BusinessMercadoPago?
  MercadoPagoOAuthAttempt MercadoPagoOAuthAttempt[]
  teamMembers             BusinessTeamMember[]
  testimonials            BusinessTestimonial[]
  faqs                    BusinessFaq[]
  promotions              BusinessPromotion[]
  bookings                Booking[]
  bookingSlots            BookingSlot[]
  reviews                 BusinessReview[]
  blogPosts               BusinessBlogPost[]
  events                  BusinessEvent[]
  subscription            BusinessSubscription?
  paymentEvents           BusinessPaymentEvent[]
  previewTokens           BusinessPreviewToken[]

  @@index([ownerId])
  @@index([category])
  @@index([status])
  @@map("businesses")
}

model BusinessMercadoPago {
  id                    String           @id @default(uuid())
  businessId            String           @unique
  business              Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mpUserId              String?          @map("mp_user_id")
  accessTokenEncrypted  String?          @map("access_token_encrypted")
  refreshTokenEncrypted String?          @map("refresh_token_encrypted")
  publicKey             String?          @map("public_key")
  connectionStatus      ConnectionStatus @default(NOT_CONNECTED) @map("connection_status")
  connectedAt           DateTime?        @map("connected_at")
  lastVerifiedAt        DateTime?        @map("last_verified_at")
  expiresAt             DateTime?        @map("expires_at")
  sandbox               Boolean          @default(true) @map("sandbox")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("business_mercado_pago")
}

model MercadoPagoOAuthAttempt {
  id                   String    @id @default(uuid())
  stateHash            String    @unique @map("state_hash")
  businessId           String    @map("business_id")
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId               String    @map("user_id")
  user                 User      @relation(fields: [userId], references: [id])
  codeVerifierHash     String?   @map("code_verifier_hash")
  codeVerifierEncrypted String?  @map("code_verifier_encrypted")
  expiresAt            DateTime  @map("expires_at")
  consumedAt           DateTime? @map("consumed_at")
  success              Boolean   @default(false)
  mpUserId             String?   @map("mp_user_id")
  error                String?   @map("error")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([stateHash])
  @@index([businessId])
  @@index([userId])
  @@map("mercadopago_oauth_attempts")
}

model BusinessService {
