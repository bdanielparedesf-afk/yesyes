  price       Float?
  durationMin Int?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, active])
  @@map("business_services")
}

model BusinessCatalogItem {
  id                 String    @id @default(uuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  shortDescription   String?
  description        String?   @db.Text
  price              Float
  compareAtPrice     Float?
  currency           String    @default("CLP")
  image              String?
  additionalImages   String[]  @default([])
  category           String?
  featured           Boolean   @default(false)
  active             Boolean   @default(true)
  sortOrder          Int       @default(0)
  cta                String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([businessId, slug])
  @@index([businessId, active, sortOrder])
  @@index([businessId, featured])
  @@map("business_catalog_items")
}

model Property {
  id          String            @id @default(uuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String?           @db.Text
  price       Float
  currency    String            @default("CLP")
  operation   PropertyOperation
  type        PropertyType
  address     String?
  city        String?
  region      String?
  bedrooms    Int?
  bathrooms   Int?
  parking     Int?
  areaBuilt   Float?
  areaTotal   Float?
  features    String[]
  lat         Float?
  lng         Float?
  agent       String?
  featured    Boolean           @default(false)
  available   Boolean           @default(true)
  published   Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  images      PropertyImage[]

  @@index([businessId])
  @@index([operation])
  @@index([type])
  @@index([city])
  @@index([businessId, published])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  position   Int      @default(0)

  @@index([propertyId])
  @@map("property_images")
}

model BusinessGalleryImage {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  title       String?
  description String?
  category    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@index([businessId, position])
  @@map("business_gallery_images")
}

model BusinessLead {
  id         String     @id @default(uuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       LeadType
  status     LeadStatus @default(NEW)
  name       String?
  phone      String?
  email      String?
  message    String?    @db.Text
  payload    Json?
  /// Origen del lead para auditoria (public_form, whatsapp, booking, etc).
  source     String?
  waClick    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt

  @@index([businessId])
  @@index([type])
  @@index([status])
  @@index([businessId, createdAt])
  @@map("business_leads")
}

model BusinessStatDaily {
  id            String   @id @default(uuid())
  businessId    String
  date          DateTime @db.Date
  pageViews     Int      @default(0)
  waClicks      Int      @default(0)
  phoneClicks   Int      @default(0)
  emailClicks   Int      @default(0)
  leads         Int      @default(0)
  productViews  Int      @default(0)
  propertyViews Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, date])
  @@index([businessId])
  @@map("business_stats_daily")
}

/// Catalogo de capacidades (modulos) que una plantilla/negocio puede activar.
/// Es data, no codigo: permite agregar modulos futuros sin migrar el modelo.
model BusinessCapability {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  group       String?
  /// Capacidades "core" no se pueden desactivar desde el panel del cliente.
  core        Boolean  @default(false)
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([order])
  @@map("business_capabilities")
}

/// Plan comercial de YesYes Business. El precio vive AQUI (nunca hardcodeado),
/// y ADMIN puede editarlo sin tocar codigo.
model BusinessPlan {
  id            String                @id @default(uuid())
  code          String                @unique
  name          String
  description   String?
  amount        Float
  currency      String                @default("CLP")
  frequency     Int                   @default(1)
  frequencyType SubscriptionFrequency @default(MONTH)
  /// Caracteristicas mostradas en la pagina de pago (copy del plan).
  features      String[]              @default([])
  trialDays     Int                   @default(0)
  active        Boolean               @default(true)
  order         Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  subscriptions BusinessSubscription[]

  @@index([active])
  @@map("business_plans")
}

/// Suscripcion mensual del negocio a YesYes (proveedor: Mercado Pago).
/// Una sola suscripcion por negocio: evita duplicados por webhooks repetidos.
model BusinessSubscription {
  id                     String                @id @default(uuid())
  businessId             String                @unique
  business               Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   BusinessPlan          @relation(fields: [planId], references: [id])
  provider               String                @default("MERCADOPAGO")
  providerSubscriptionId String?               @unique
  providerPlanId         String?
  status                 SubscriptionStatus    @default(NONE)
  amount                 Float
  currency               String                @default("CLP")
  frequency              Int                   @default(1)
  frequencyType          SubscriptionFrequency @default(MONTH)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  nextPaymentAt          DateTime?
  graceUntil             DateTime?
  cancelAtPeriodEnd      Boolean               @default(false)
  activatedAt            DateTime?
  cancelledAt            DateTime?
  lastPaymentAt          DateTime?
  lastEventAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  paymentEvents          BusinessPaymentEvent[]

  @@index([businessId])
  @@index([providerSubscriptionId])
  @@index([status])
  @@index([nextPaymentAt])
  @@map("business_subscriptions")
}

/// Auditoria + idempotencia de eventos de pago de Mercado Pago (Business).
/// La clave unica (provider, providerEventId) impide procesar dos veces el
/// mismo webhook: nunca duplica suscripciones, pagos ni publicaciones.
model BusinessPaymentEvent {
  id              String                @id @default(uuid())
  businessId      String
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    BusinessSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider        String                @default("MERCADOPAGO")
  providerEventId String
  eventType       String
  status          String
  amount          Float?
  currency        String?
  payload         Json?
  processedAt     DateTime?
  createdAt       DateTime              @default(now())

  @@unique([provider, providerEventId])
  @@index([businessId])
  @@index([subscriptionId])
  @@index([createdAt])
  @@map("business_payment_events")
}

/// Token de vista previa (aleatorio, expirable y revocable). Se guarda solo
/// el hash: el valor en claro nunca toca la base de datos ni los logs.
model BusinessPreviewToken {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdBy  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
  @@index([expiresAt])
  @@map("business_preview_tokens")
}

model BusinessTeamMember {
  id         String   @id @default(uuid())
  businessId String
