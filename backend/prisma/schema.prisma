  TEMU
  AMAZON
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SUPPLIER_ORDERED
  SUPPLIER_PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUND_PROCESSING
  REFUNDED
  DISPUTED
  PENDING
  FULFILLED
  RETURN_REQUESTED
  RETURNED
