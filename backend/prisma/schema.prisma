/// Disponibilidad configurable (v1: ventana por dia de la semana).
model BookingSlot {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// 0 = domingo ... 6 = sabado (mismo criterio que Date.getDay()).
  weekday    Int
  startTime  String
  endTime    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, weekday])
  @@map("business_booking_slots")
}

model Booking {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId   String?
  serviceName String?
  date        DateTime
  time        String
  name        String
  phone       String?
  email       String?
  message     String?       @db.Text
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([businessId])
  @@index([businessId, date])
  @@index([status])
  @@map("business_bookings")
}

/// Resenas del negocio: separadas de ProductReview (nunca se mezclan).
/// Entran como PENDING y solo se publican tras moderacion del owner/ADMIN.
model BusinessReview {
  id         String               @id @default(uuid())
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  rating     Int
  content    String               @db.Text
  status     BusinessReviewStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([businessId])
  @@index([businessId, status])
  @@map("business_reviews")
}

/// Blog del negocio: arquitectura lista y funcional en su version minima.
model BusinessBlogPost {
  id             String         @id @default(uuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  excerpt        String?
  content        String         @db.Text
  cover          String?
  status         BlogPostStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, status])
  @@map("business_blog_posts")
}

/// Eventos del negocio (talleres, ferias, fechas especiales, etc).
model BusinessEvent {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  cover       String?
  startAt     DateTime
  endAt       DateTime?
  location    String?
  url         String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([businessId, startAt])
  @@map("business_events")
}

enum ProductStatus {
