{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "backend/dist/**",
        "backend/node_modules/@auth/**",
        "backend/node_modules/@panva/**",
        "backend/node_modules/jose/**",
        "backend/node_modules/oauth4webapi/**",
        "backend/node_modules/preact/**",
        "backend/node_modules/preact-render-to-string/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.yesyes.cl"
        }
      ],
      "destination": "https://yesyes.cl/$1",
      "permanent": true
    }
  ]
}
