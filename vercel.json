{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/node_modules/{@auth,@panva,jose,oauth4webapi,preact,preact-render-to-string}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.yesyes.cl"
        }
      ],
      "destination": "https://yesyes.cl/$1",
      "permanent": true
    }
  ]
}
